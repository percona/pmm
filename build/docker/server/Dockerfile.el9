FROM oraclelinux:9-slim

ARG VERSION
ARG BUILD_DATE
ARG PMM_PERCONA_PLATFORM_ADDRESS

ENV LANG=en_US.utf8
ENV GF_PLUGIN_DIR=/srv/grafana/plugins
ENV PERCONA_TELEMETRY_DISABLE=1
ENV PS1="[\u@\h \W] # "
ENV PMM_PERCONA_PLATFORM_ADDRESS=${PMM_PERCONA_PLATFORM_ADDRESS}

WORKDIR /opt

# Packages come without docs and non-English translations, here and in the playbooks below.
RUN --mount=type=cache,target=/var/cache \
    echo 'tsflags=nodocs' >> /etc/dnf/dnf.conf && \
    echo '%_install_langs en_US:en' > /etc/rpm/macros.image-language-conf && \
    microdnf -y --nodocs install ansible-core glibc-langpack-en vi

COPY entrypoint.sh /opt/entrypoint.sh
COPY ansible /opt/ansible
COPY gitCommit /tmp/gitCommit

# EPEL (the only source of the Ansible collections), dnf (used by the playbooks) and pip (installs
# supervisor) are installed and removed in this one step, so no layer keeps them. systemd goes
# too: PostgreSQL and nginx require it only for their unit files, supervisord runs them.
RUN --mount=type=cache,target=/var/cache \
    --mount=type=bind,source=binaries,target=/tmp/binaries \
    --mount=type=bind,source=pmm-client.tar.gz,target=/tmp/pmm-client.tar.gz \
    microdnf -y --nodocs install epel-release && \
    microdnf -y --nodocs install ansible-collection-community-general \
                                 ansible-collection-community-postgresql \
                                 dnf && \
    install -T -p -m 644 /opt/ansible/ansible.cfg /etc/ansible/ansible.cfg && \
    install -T -p -m 644 /opt/ansible/hosts /etc/ansible/hosts && \
    ansible-playbook -vvv /opt/ansible/pmm-docker/main.yml && \
    ansible-playbook -vvv /opt/ansible/pmm-docker/post-build.yml && \
    rpm -e --nodeps systemd && \
    rpm -e $(rpm -q --qf '%{NAME}\n' \
                oracle-epel-release-el9 yum-utils dnf-plugins-core python3-dnf-plugins-core \
                dnf python3-dnf python3-libdnf python3-hawkey python3-libcomps libcomps \
                python3-gpg python3-rpm rpm-build-libs rpm-sign-libs rpm-plugin-systemd-inhibit \
                ima-evm-utils tpm2-tss attr keyutils libgomp elfutils-libs elfutils-default-yama-scope \
                python3-dbus dbus-libs python3-dateutil python3-systemd \
                acl dbus dbus-broker dbus-common kmod-libs libseccomp systemd-pam systemd-rpm-macros \
                percona-release python3-pip \
             | grep -v 'is not installed') && \
    sed -i -e '/^assumeyes/d' -e '/^tsflags=nodocs$/d' /etc/dnf/dnf.conf

LABEL org.opencontainers.image.created=${BUILD_DATE}
LABEL org.opencontainers.image.licenses=AGPL-3.0
LABEL org.opencontainers.image.title="Percona Monitoring and Management"
LABEL org.opencontainers.image.vendor="Percona LLC"
LABEL org.opencontainers.image.version=${VERSION}
LABEL com.percona.pmm=true

USER 1000

VOLUME [ "/srv" ]

EXPOSE 8080 8443

# Sized on a cold boot against an empty volume: 34s to first pass readyz on fast
# local storage, near 90s on slower hardware. The previous 25s grace period ended
# before that, so three failed probes marked the container unhealthy around 34s,
# and a dependent gated on service_healthy aborted whenever compose polled during
# the few seconds before it recovered.
HEALTHCHECK --interval=4s --timeout=2s --start-period=90s --retries=3 CMD curl -sf http://127.0.0.1:8080/v1/server/readyz

CMD ["/opt/entrypoint.sh"]
