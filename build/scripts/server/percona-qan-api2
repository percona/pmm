# Sourced by build-server-binaries.

key() {
    echo ${pmm_version}-$(get_shortcommit pmm)
}

build() {
    run_in_container $1 pmm <<EOF
export PMM_RELEASE_VERSION=${full_pmm_version}
export PMM_RELEASE_FULLCOMMIT=$(get_commit pmm)
export PMM_RELEASE_BRANCH=""

cd ${build_dir}
make -C qan-api2 release

install -d ${rootfs}/usr/sbin
install -p -m 0755 bin/qan-api2 ${rootfs}/usr/sbin/percona-qan-api2
EOF
}

