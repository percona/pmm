#!/bin/bash
set -o errexit
set -o xtrace

. "$(dirname $0)"/vars

# 1st-party
# The 3rd arg scopes the cache key to the given paths (the package sources plus
# its spec) so the package is rebuilt only when those actually change.
"${bin_dir}/build-server-rpm" percona-dashboards pmm "dashboards build/packages/rpm/server/SPECS/percona-dashboards.spec"
"${bin_dir}/build-server-rpm" pmm-managed pmm
"${bin_dir}/build-server-rpm" pmm-ui pmm "ui build/packages/rpm/server/SPECS/pmm-ui.spec"
"${bin_dir}/build-server-rpm" percona-qan-api2 pmm
"${bin_dir}/build-server-rpm" pmm-dump
"${bin_dir}/build-server-rpm" vmproxy pmm

# 3rd-party
"${bin_dir}/build-server-rpm" victoriametrics
"${bin_dir}/build-server-rpm" grafana

# vim: expandtab shiftwidth=4 tabstop=4
