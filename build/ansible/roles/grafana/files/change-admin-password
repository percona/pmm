#!/bin/bash
#
# Change password for default admin user in PMM

# `docker exec` does not run the entrypoint, so the variables given as Vault references, such as
# GF_DATABASE_PASSWORD, are resolved here as they are for PMM Server itself.
declare ADMIN_PASSWORD_REF="$GF_SECURITY_ADMIN_PASSWORD"
if [ -n "$PMM_VAULT_ADDRESS" ]; then
    declare VAULT_EXPORTS
    if ! VAULT_EXPORTS=$(pmm-managed-init vault-env); then
        echo "Failed to read the PMM Server secrets from Vault." >&2
        exit 1
    fi
    eval "$VAULT_EXPORTS"
    unset VAULT_EXPORTS
fi

grafana cli --config=/etc/grafana/grafana.ini --homepath /usr/share/grafana admin reset-admin-password "$1" || exit

# Vault holds the password a PMM Server with an empty Grafana database creates the admin user with,
# so it is kept up to date. Passed on stdin to keep it out of the process list.
if [[ "$ADMIN_PASSWORD_REF" == vault:* ]]; then
    if ! printf '%s' "$1" | pmm-managed-init vault-put "$ADMIN_PASSWORD_REF"; then
        echo "The password was changed, but storing it in Vault ($ADMIN_PASSWORD_REF) failed." >&2
        exit 1
    fi
fi
