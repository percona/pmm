# Built locally by `make doc-build-image`, with documentation/ as the context.
FROM python:3.14-slim AS wheels

# libsass, a mkdocs-with-pdf dependency, has no arm64 wheel and builds from source.
RUN apt-get update && apt-get install -y --no-install-recommends build-essential
COPY requirements.txt /tmp/requirements.txt
RUN pip wheel --no-cache-dir --wheel-dir /wheels -r /tmp/requirements.txt

FROM python:3.14-slim

# Pango for WeasyPrint; the fonts are what the PDF falls back to for its serif, sans, mono and emoji text.
RUN apt-get update && \
    apt-get install -y --no-install-recommends git libpango-1.0-0 libpangoft2-1.0-0 \
        fonts-dejavu-core fonts-dejavu-extra fonts-dejavu-mono fonts-liberation fonts-noto-color-emoji && \
    rm -rf /var/lib/apt/lists/*

COPY requirements.txt /tmp/requirements.txt
RUN --mount=type=bind,from=wheels,source=/wheels,target=/wheels \
    pip install --no-cache-dir --root-user-action=ignore --no-index --find-links=/wheels -r /tmp/requirements.txt

WORKDIR /docs

EXPOSE 8000
CMD ["mkdocs","build"]
