{
  "swagger": "2.0",
  "info": {
    "title": "pom/v1/pom.proto",
    "version": "version not set"
  },
  "tags": [
    {
      "name": "PomService"
    }
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/v1/pom/discovery/runs": {
      "get": {
        "summary": "List discovery runs",
        "description": "Returns the recorded discovery runs, newest first, with what each one saw and any errors it hit.",
        "operationId": "ListDiscoveryRuns",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1ListDiscoveryRunsResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "limit",
            "description": "How many runs to return, newest first. Defaults to 25, capped at 100.",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          }
        ],
        "tags": [
          "PomService"
        ]
      },
      "post": {
        "summary": "Trigger a discovery run",
        "description": "Rebuilds the topology document from PMM inventory and VictoriaMetrics, and records the run.",
        "operationId": "TriggerDiscovery",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1TriggerDiscoveryResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "description": "TriggerDiscoveryRequest is the request for TriggerDiscovery.",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v1TriggerDiscoveryRequest"
            }
          }
        ],
        "tags": [
          "PomService"
        ]
      }
    },
    "/v1/pom/discovery/runs/{run_id}": {
      "get": {
        "summary": "Get a discovery run",
        "description": "Returns one recorded discovery run, with what it saw, how each source answered, and any errors it hit.",
        "operationId": "GetDiscoveryRun",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1GetDiscoveryRunResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "run_id",
            "description": "The run to return.",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "PomService"
        ]
      }
    },
    "/v1/pom/topology": {
      "get": {
        "summary": "Get the MongoDB topology",
        "description": "Returns every monitored MongoDB service, grouped by environment then cluster, with its identity, replica-set state, reachability and load.",
        "operationId": "GetTopology",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1GetTopologyResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "tags": [
          "PomService"
        ]
      }
    }
  },
  "definitions": {
    "protobufAny": {
      "type": "object",
      "properties": {
        "@type": {
          "type": "string"
        }
      },
      "additionalProperties": {}
    },
    "rpcStatus": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "format": "int32"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/protobufAny"
          }
        }
      }
    },
    "v1Cluster": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Cluster label, unset when its services carry none."
        },
        "services": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1Service"
          },
          "description": "Its services, ordered by name."
        }
      },
      "description": "Cluster represents one cluster or replica set."
    },
    "v1Environment": {
      "type": "object",
      "properties": {
        "env_name": {
          "type": "string",
          "description": "Environment label, unset when its services carry none."
        },
        "clusters": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1Cluster"
          },
          "description": "Its clusters, ordered by name."
        }
      },
      "description": "Environment represents one monitoring environment."
    },
    "v1GetDiscoveryRunResponse": {
      "type": "object",
      "properties": {
        "run": {
          "$ref": "#/definitions/v1Run",
          "description": "The run."
        }
      },
      "description": "GetDiscoveryRunResponse returns one discovery run."
    },
    "v1GetTopologyResponse": {
      "type": "object",
      "properties": {
        "snapshot": {
          "$ref": "#/definitions/v1Snapshot",
          "description": "Which run produced this, when, and whether it is stale."
        },
        "origin_node": {
          "type": "string",
          "description": "The PMM node the document was assembled on."
        },
        "source_queries": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "The VictoriaMetrics queries the document was derived from."
        },
        "summary": {
          "$ref": "#/definitions/v1Summary",
          "description": "Fleet-level counts."
        },
        "environments": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1Environment"
          },
          "description": "The estate, grouped environment then cluster."
        }
      },
      "description": "GetTopologyResponse is the whole topology document plus the provenance of the run\nbehind it."
    },
    "v1ListDiscoveryRunsResponse": {
      "type": "object",
      "properties": {
        "runs": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1Run"
          },
          "description": "The runs."
        }
      },
      "description": "ListDiscoveryRunsResponse returns the run history, newest first."
    },
    "v1Run": {
      "type": "object",
      "properties": {
        "run_id": {
          "type": "string",
          "description": "The run's ID, also the snapshot key."
        },
        "status": {
          "type": "string",
          "description": "running, success, partial or failed."
        },
        "started_at": {
          "type": "string",
          "format": "date-time",
          "description": "When the run began."
        },
        "finished_at": {
          "type": "string",
          "format": "date-time",
          "description": "When it reached a terminal status; unset while running."
        },
        "counts": {
          "$ref": "#/definitions/v1RunCounts",
          "description": "What it saw."
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1RunError"
          },
          "description": "Query-level, service-level and run-level failures."
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1SourceReport"
          },
          "description": "How completely each discovery source answered."
        }
      },
      "description": "Run represents one discovery run."
    },
    "v1RunCounts": {
      "type": "object",
      "properties": {
        "services_total": {
          "type": "integer",
          "format": "int32",
          "description": "MongoDB services inventory reported."
        },
        "services_resolved": {
          "type": "integer",
          "format": "int32",
          "description": "...of which carried a service ID to join metrics on."
        },
        "services_orphaned": {
          "type": "integer",
          "format": "int32",
          "description": "...of which did not. Not an error."
        },
        "probes_ok": {
          "type": "integer",
          "format": "int32",
          "description": "Services metrics actually observed as reachable."
        },
        "services_stale": {
          "type": "integer",
          "format": "int32",
          "description": "Services carrying at least one volatile fact too old to read as current."
        }
      },
      "description": "RunCounts counts what one discovery run saw."
    },
    "v1RunError": {
      "type": "object",
      "properties": {
        "scope": {
          "type": "string",
          "description": "What the error is about, e.g. \"run\" or \"query\"."
        },
        "service_name": {
          "type": "string",
          "description": "The service it concerns, when scoped to one."
        },
        "code": {
          "type": "string",
          "description": "A machine-readable cause."
        },
        "message": {
          "type": "string",
          "description": "The human-readable detail."
        }
      },
      "description": "RunError describes one thing that went wrong during a run."
    },
    "v1Service": {
      "type": "object",
      "properties": {
        "service_name": {
          "type": "string",
          "description": "Service name as PMM inventory registered it."
        },
        "host": {
          "type": "string",
          "description": "Node the service runs on."
        },
        "endpoint": {
          "type": "string",
          "description": "host:port as the replica set itself addresses the member."
        },
        "service_id": {
          "type": "string",
          "description": "PMM's service ID. The join key against VictoriaMetrics."
        },
        "service_type": {
          "type": "string",
          "description": "Always \"mongodb\" today."
        },
        "version": {
          "type": "string",
          "description": "Running server version."
        },
        "vendor": {
          "type": "string",
          "description": "MongoDB or Percona."
        },
        "edition": {
          "type": "string",
          "description": "Community or Enterprise."
        },
        "replication_set": {
          "type": "string",
          "description": "Replica set, or unset for a router or a standalone."
        },
        "state": {
          "type": "string",
          "description": "PRIMARY, SECONDARY or ARBITER, or unset where there is no replica-set state."
        },
        "status": {
          "type": "string",
          "description": "UP when the exporter reached the service, DOWN when it did not."
        },
        "cpu_usage_percent": {
          "type": "number",
          "format": "double",
          "description": "CPU percentage, or -1 when not measured."
        },
        "connections_free_percent": {
          "type": "number",
          "format": "double",
          "description": "Percentage of free connections, or -1 when not measured."
        },
        "process_role": {
          "type": "string",
          "description": "mongod, mongos, configsvr or shardsvr."
        },
        "replication_lag_seconds": {
          "type": "number",
          "format": "double",
          "description": "Seconds this member trails the primary; unset where there is no primary to trail."
        },
        "oplog_window_seconds": {
          "type": "number",
          "format": "double",
          "description": "Seconds of history the oplog holds; unset where there is no replica-set oplog."
        },
        "installed_version": {
          "type": "string",
          "description": "The MongoDB binary installed on the node, which is not necessarily the one\nrunning. Divergence from `version` is the upgraded-but-not-restarted case. Only\nan on-host probe can see it, so this is unset wherever one has not run."
        },
        "config_path": {
          "type": "string",
          "description": "The configuration file the running server read. Probe-only."
        },
        "argv": {
          "type": "string",
          "description": "The command line the running server was started with. Probe-only."
        }
      },
      "description": "Service represents one monitored MongoDB service as the topology document records it.\n\nTwo sentinel conventions, and they differ on purpose. cpu_usage_percent and\nconnections_free_percent are -1 when not measured, never null and never 0, because\nzero CPU is a legitimate reading and a numeric column must keep \"idle\" and \"unknown\"\napart. replication_lag_seconds and oplog_window_seconds are null when they do not\napply -- a router and a standalone have no replica-set oplog -- which is a different\nstatement from -1's \"we could not measure it\"."
    },
    "v1Snapshot": {
      "type": "object",
      "properties": {
        "generated_at": {
          "type": "string",
          "format": "date-time",
          "description": "When the document was assembled."
        },
        "observed_at": {
          "type": "string",
          "format": "date-time",
          "description": "The newest observation in it, unset when nothing was observed at all."
        },
        "stale": {
          "type": "boolean",
          "description": "Whether the document is older than the staleness grace period."
        },
        "schema_version": {
          "type": "integer",
          "format": "int32",
          "description": "The document schema version."
        },
        "run_id": {
          "type": "string",
          "description": "The discovery run that produced it."
        }
      },
      "description": "Snapshot carries the provenance every snapshot-backed response repeats."
    },
    "v1SourceReport": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "description": "The source key, e.g. \"inventory\", \"metrics\" or \"probe\"."
        },
        "status": {
          "type": "string",
          "description": "ok, partial, failed or disabled."
        },
        "facts": {
          "type": "integer",
          "format": "int32",
          "description": "How many facts it produced."
        },
        "detail": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Source-specific counters, rendered as strings so a source can report whatever it has\nwithout this contract naming every counter."
        }
      },
      "description": "SourceReport says how completely one discovery source answered, and what it saw.\n\nRecorded per source so a thin document is legible rather than merely thin: a snapshot\nassembled with metrics=ok and probe=failed is still correct about every version and\nhonest about reachability."
    },
    "v1Summary": {
      "type": "object",
      "properties": {
        "environments": {
          "type": "integer",
          "format": "int32",
          "description": "Environments in the document."
        },
        "clusters": {
          "type": "integer",
          "format": "int32",
          "description": "Clusters across all of them."
        },
        "services_total": {
          "type": "integer",
          "format": "int32",
          "description": "Services in the document."
        },
        "services_up": {
          "type": "integer",
          "format": "int32",
          "description": "Services the exporter reached."
        },
        "services_down": {
          "type": "integer",
          "format": "int32",
          "description": "Services it did not."
        },
        "by_process_role": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "format": "int32"
          },
          "description": "Service counts per process role."
        }
      },
      "description": "Summary carries the fleet-level counts, so a caller need not re-derive them."
    },
    "v1TriggerDiscoveryRequest": {
      "type": "object",
      "description": "TriggerDiscoveryRequest is the request for TriggerDiscovery."
    },
    "v1TriggerDiscoveryResponse": {
      "type": "object",
      "properties": {
        "run_id": {
          "type": "string",
          "description": "The run's ID."
        },
        "status": {
          "type": "string",
          "description": "The run's terminal status."
        },
        "started_at": {
          "type": "string",
          "format": "date-time",
          "description": "When the run began."
        }
      },
      "description": "TriggerDiscoveryResponse acknowledges a completed discovery run."
    }
  }
}
