                    "sources": {
                      "description": "Only lines from these sources (the component for PMM Server logs, the node for client logs).",
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "x-order": 3
                    },
                    "presets": {
                      "description": "Only lines read with these parser presets.",
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "x-order": 4
                    },
                    "min_severity": {
                      "description": "Only lines with at least this OpenTelemetry severity number (17 error, 13 warning, 9 info).",
                      "type": "integer",
                      "format": "int32",
                      "x-order": 5
                    },
                    "text": {
                      "description": "Only lines containing this text, ignoring case.",
                      "type": "string",
                      "x-order": 6
                    },
                    "pattern": {
                      "description": "Only lines with this pattern, as returned by GetLogPatterns.",
                      "type": "string",
                      "x-order": 7
                    }
                  },
                  "x-order": 0
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "type": "object",
              "properties": {
                "patterns": {
                  "description": "Up to 50 patterns, most frequent first.",
                  "type": "array",
                  "items": {
                    "description": "LogPattern is a group of lines that differ only in values.",
                    "type": "object",
                    "properties": {
                      "pattern": {
                        "type": "string",
                        "x-order": 0
                      },
                      "count": {
                        "description": "Lines with this pattern in the time range.",
                        "type": "string",
                        "format": "int64",
                        "x-order": 1
                      },
                      "max_severity_number": {
                        "type": "integer",
                        "format": "int32",
                        "x-order": 2
                      },
                      "first_seen": {
                        "type": "string",
                        "format": "date-time",
                        "x-order": 3
                      },
                      "last_seen": {
                        "type": "string",
                        "format": "date-time",
                        "x-order": 4
                      },
                      "sample": {
                        "description": "One line with this pattern.",
                        "type": "string",
                        "x-order": 5
                      },
                      "is_new": {
                        "description": "True when the pattern did not occur in the preceding range of the same length.",
                        "type": "boolean",
                        "x-order": 6
                      }
                    }
                  },
                  "x-order": 0
                }
              }
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "integer",
                  "format": "int32",
                  "x-order": 0
                },
                "message": {
                  "type": "string",
                  "x-order": 1
                },
                "details": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "@type": {
                        "type": "string",
                        "x-order": 0
                      }
                    },
                    "additionalProperties": {}
                  },
                  "x-order": 2
                }
              }
            }
          }
        }
      }
