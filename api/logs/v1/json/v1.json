{
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "schemes": [
    "https",
    "http"
  ],
  "swagger": "2.0",
  "info": {
    "title": "PMM Logs API",
    "version": "v1"
  },
  "paths": {
    "/v1/logs:getContext": {
      "post": {
        "description": "Returns the lines before and after a line of the same node and file.",
        "tags": [
          "LogsService"
        ],
        "summary": "Get log context",
        "operationId": "GetLogContext",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "time": {
                  "description": "Time of the line to show context for.",
                  "type": "string",
                  "format": "date-time",
                  "x-order": 0
                },
                "node_name": {
                  "type": "string",
                  "x-order": 1
                },
                "file_name": {
                  "type": "string",
                  "x-order": 2
                },
                "lines": {
                  "description": "Lines before and after; 0 means 50.",
                  "type": "integer",
                  "format": "int32",
                  "x-order": 3
                },
                "source": {
                  "description": "Source of the line; optional, narrows the scan.",
                  "type": "string",
                  "x-order": 4
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "type": "object",
              "properties": {
                "lines": {
                  "description": "Lines of the same node and file, oldest first.",
                  "type": "array",
                  "items": {
                    "description": "LogLine is one log entry.",
                    "type": "object",
                    "properties": {
                      "time": {
                        "type": "string",
                        "format": "date-time",
                        "x-order": 0
                      },
                      "node_name": {
                        "type": "string",
                        "x-order": 1
                      },
                      "source": {
                        "type": "string",
                        "x-order": 2
                      },
                      "preset": {
                        "type": "string",
                        "x-order": 3
                      },
                      "file_name": {
                        "type": "string",
                        "x-order": 4
                      },
                      "severity_number": {
                        "type": "integer",
                        "format": "int32",
                        "x-order": 5
                      },
                      "severity_text": {
                        "type": "string",
                        "x-order": 6
                      },
                      "body": {
                        "description": "Body, cut to 4 KiB in lists and 64 KiB in context.",
                        "type": "string",
                        "x-order": 7
                      },
                      "body_truncated": {
                        "description": "True when body was cut.",
                        "type": "boolean",
                        "x-order": 8
                      },
                      "attributes": {
                        "type": "object",
                        "additionalProperties": {
                          "type": "string"
                        },
                        "x-order": 9
                      }
                    }
                  },
                  "x-order": 0
                },
                "anchor_index": {
                  "description": "Index in lines of the line at the requested time.",
                  "type": "integer",
                  "format": "int32",
                  "x-order": 1
                }
              }
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "integer",
                  "format": "int32",
                  "x-order": 0
                },
                "message": {
                  "type": "string",
                  "x-order": 1
                },
                "details": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "@type": {
                        "type": "string",
                        "x-order": 0
                      }
                    },
                    "additionalProperties": {}
                  },
                  "x-order": 2
                }
              }
            }
          }
        }
      }
    },
    "/v1/logs:getFacets": {
      "post": {
        "description": "Returns the nodes, sources and parser presets with lines in the time range, with line counts.",
        "tags": [
          "LogsService"
        ],
        "summary": "Get log facets",
        "operationId": "GetLogFacets",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "filter": {
                  "description": "LogFilter selects log lines; every logs call takes it.",
                  "type": "object",
                  "properties": {
                    "start": {
                      "description": "Start of the time range.",
                      "type": "string",
                      "format": "date-time",
                      "x-order": 0
                    },
                    "end": {
                      "description": "End of the time range.",
                      "type": "string",
                      "format": "date-time",
                      "x-order": 1
                    },
                    "node_names": {
                      "description": "Only lines from these nodes.",
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "x-order": 2
                    },
                    "sources": {
                      "description": "Only lines from these sources (the component for PMM Server logs, the node for client logs).",
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "x-order": 3
                    },
                    "presets": {
                      "description": "Only lines read with these parser presets.",
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "x-order": 4
                    },
                    "min_severity": {
                      "description": "Only lines with at least this OpenTelemetry severity number (17 error, 13 warning, 9 info).",
                      "type": "integer",
                      "format": "int32",
                      "x-order": 5
                    },
                    "text": {
                      "description": "Only lines containing this text, ignoring case.",
                      "type": "string",
                      "x-order": 6
                    },
                    "pattern": {
                      "description": "Only lines with this pattern, as returned by GetLogPatterns.",
                      "type": "string",
                      "x-order": 7
                    }
                  },
                  "x-order": 0
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "type": "object",
              "properties": {
                "node_names": {
                  "type": "array",
                  "items": {
                    "description": "Facet is one filter value with its line count.",
                    "type": "object",
                    "properties": {
                      "value": {
                        "type": "string",
                        "x-order": 0
                      },
                      "count": {
                        "type": "string",
                        "format": "int64",
                        "x-order": 1
                      }
                    }
                  },
                  "x-order": 0
                },
                "sources": {
                  "type": "array",
                  "items": {
                    "description": "Facet is one filter value with its line count.",
                    "type": "object",
                    "properties": {
                      "value": {
                        "type": "string",
                        "x-order": 0
                      },
                      "count": {
                        "type": "string",
                        "format": "int64",
                        "x-order": 1
                      }
                    }
                  },
                  "x-order": 1
                },
                "presets": {
                  "type": "array",
                  "items": {
                    "description": "Facet is one filter value with its line count.",
                    "type": "object",
                    "properties": {
                      "value": {
                        "type": "string",
                        "x-order": 0
                      },
                      "count": {
                        "type": "string",
                        "format": "int64",
                        "x-order": 1
                      }
                    }
                  },
                  "x-order": 2
                }
              }
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "integer",
                  "format": "int32",
                  "x-order": 0
                },
                "message": {
                  "type": "string",
                  "x-order": 1
                },
                "details": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "@type": {
                        "type": "string",
                        "x-order": 0
                      }
                    },
                    "additionalProperties": {}
                  },
                  "x-order": 2
                }
              }
            }
          }
        }
      }
    },
    "/v1/logs:getPatterns": {
      "post": {
        "description": "Returns the most frequent log patterns, marking those absent from the preceding range.",
        "tags": [
          "LogsService"
        ],
        "summary": "Get log patterns",
        "operationId": "GetLogPatterns",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "filter": {
                  "description": "LogFilter selects log lines; every logs call takes it.",
                  "type": "object",
                  "properties": {
                    "start": {
                      "description": "Start of the time range.",
                      "type": "string",
                      "format": "date-time",
                      "x-order": 0
                    },
                    "end": {
                      "description": "End of the time range.",
                      "type": "string",
                      "format": "date-time",
                      "x-order": 1
