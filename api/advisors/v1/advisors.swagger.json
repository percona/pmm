  "definitions": {
    "AdvisorServiceUpdateAdvisorCheckBody": {
      "type": "object",
      "properties": {
        "check": {
          "$ref": "#/definitions/v1AdvisorCheck",
          "description": "The updated check definition. A check cannot be renamed: leave its name\nempty or set it to the name above, otherwise the request is rejected."
        }
      }
    },
    "protobufAny": {
      "type": "object",
      "properties": {
        "@type": {
          "type": "string"
        }
      },
      "additionalProperties": {}
    },
    "rpcStatus": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "format": "int32"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/protobufAny"
          }
        }
      }
    },
    "v1Advisor": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Deprecated: no longer populated; an advisor is identified by its category."
        },
        "description": {
          "type": "string",
          "description": "Deprecated: advisor descriptions were removed."
        },
        "summary": {
          "type": "string",
          "description": "Deprecated: use category instead."
        },
        "comment": {
          "type": "string",
          "description": "Deprecated: no longer populated."
        },
        "category": {
          "type": "string",
          "description": "Category the checks belong to."
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1AdvisorCheck"
          },
          "description": "Advisor checks."
        }
      }
    },
    "v1AdvisorCheck": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Machine-readable name (ID) that is used in expression."
        },
        "enabled": {
          "type": "boolean",
          "description": "True if that check is enabled."
        },
        "description": {
          "type": "string",
          "description": "Long human-readable description."
        },
        "summary": {
          "type": "string",
          "description": "Short human-readable summary."
        },
        "interval": {
          "$ref": "#/definitions/v1AdvisorCheckInterval",
          "description": "Check execution interval."
        },
        "technology": {
          "$ref": "#/definitions/v1AdvisorCheckTechnology",
          "description": "DB technology."
        },
        "category": {
          "type": "string",
          "description": "Category the check belongs to."
        },
        "user_defined": {
          "type": "boolean",
          "description": "True if the check is user-authored (editable/deletable); false for Percona-shipped checks."
        },
        "queries": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1AdvisorCheckQuery"
          },
          "description": "Data-collection queries. Populated by Get/Create/Update; may be empty in list responses."
        },
        "script": {
          "type": "string",
          "description": "Starlark source script. Populated by Get/Create/Update; may be empty in list responses."
        },
        "disabled_service_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "IDs of services for which this check is disabled."
        }
      },
      "description": "AdvisorCheck contains check name and status."
    },
    "v1AdvisorCheckInterval": {
      "type": "string",
      "enum": [
        "ADVISOR_CHECK_INTERVAL_UNSPECIFIED",
        "ADVISOR_CHECK_INTERVAL_STANDARD",
        "ADVISOR_CHECK_INTERVAL_FREQUENT",
        "ADVISOR_CHECK_INTERVAL_RARE"
      ],
      "default": "ADVISOR_CHECK_INTERVAL_UNSPECIFIED",
      "description": "AdvisorCheckInterval represents possible execution interval values for checks."
    },
    "v1AdvisorCheckQuery": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "description": "Query type, e.g. \"MYSQL_SHOW\", \"POSTGRESQL_SELECT\", \"METRICS_RANGE\"."
        },
        "query": {
          "type": "string",
          "description": "Query text (may be empty for parameterless types such as MYSQL_SHOW)."
        },
        "parameters": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Optional query parameters (e.g. range/step for metrics range queries)."
        }
      },
      "description": "AdvisorCheckQuery is a single data-collection query of an advisor check."
    },
    "v1AdvisorCheckResultStatus": {
      "type": "string",
      "enum": [
        "ADVISOR_CHECK_RESULT_STATUS_UNSPECIFIED",
        "ADVISOR_CHECK_RESULT_STATUS_OK",
        "ADVISOR_CHECK_RESULT_STATUS_FAILED",
        "ADVISOR_CHECK_RESULT_STATUS_ERROR"
      ],
      "default": "ADVISOR_CHECK_RESULT_STATUS_UNSPECIFIED",
      "description": "AdvisorCheckResultStatus represents the outcome of an Advisor check run against a service.\n\n - ADVISOR_CHECK_RESULT_STATUS_OK: The check ran and found no issue.\n - ADVISOR_CHECK_RESULT_STATUS_FAILED: The check ran and detected an issue.\n - ADVISOR_CHECK_RESULT_STATUS_ERROR: The check could not be executed."
    },
    "v1AdvisorCheckTechnology": {
      "type": "string",
      "enum": [
        "ADVISOR_CHECK_TECHNOLOGY_UNSPECIFIED",
        "ADVISOR_CHECK_TECHNOLOGY_MYSQL",
        "ADVISOR_CHECK_TECHNOLOGY_POSTGRESQL",
        "ADVISOR_CHECK_TECHNOLOGY_MONGODB"
      ],
      "default": "ADVISOR_CHECK_TECHNOLOGY_UNSPECIFIED"
    },
    "v1AdvisorCheckTestTarget": {
      "type": "object",
      "properties": {
        "service_id": {
          "type": "string",
          "description": "ID of the eligible service."
        },
        "service_name": {
          "type": "string",
          "description": "Name of the eligible service."
        }
      },
      "description": "AdvisorCheckTestTarget is a service an advisor check can be tested against."
    },
    "v1AdvisorCheckTriggeredBy": {
      "type": "string",
      "enum": [
        "ADVISOR_CHECK_TRIGGERED_BY_UNSPECIFIED",
        "ADVISOR_CHECK_TRIGGERED_BY_USER",
        "ADVISOR_CHECK_TRIGGERED_BY_SCHEDULER"
      ],
      "default": "ADVISOR_CHECK_TRIGGERED_BY_UNSPECIFIED",
      "description": "AdvisorCheckTriggeredBy represents the actor that initiated an Advisor check run.\n\n - ADVISOR_CHECK_TRIGGERED_BY_USER: The run was started by a user via the API or UI.\n - ADVISOR_CHECK_TRIGGERED_BY_SCHEDULER: The run was started by the built-in scheduler."
    },
    "v1AdvisorRun": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "ID shared by every insight the run produced."
        },
        "triggered_by": {
          "$ref": "#/definitions/v1AdvisorCheckTriggeredBy",
          "description": "The actor that initiated the run."
        },
        "started_at": {
          "type": "string",
          "format": "date-time",
          "description": "When the run began."
        },
        "finished_at": {
          "type": "string",
          "format": "date-time",
          "description": "When the run completed; unset while it is still running."
        },
        "checks_count": {
          "type": "integer",
          "format": "int32",
          "description": "Number of distinct checks the run executed."
        },
        "services_count": {
          "type": "integer",
          "format": "int32",
          "description": "Number of distinct services the run covered."
        },
        "findings_count": {
          "type": "integer",
          "format": "int32",
          "description": "Number of findings, i.e. checks that detected an issue."
        },
        "errors_count": {
          "type": "integer",
          "format": "int32",
          "description": "Number of checks that could not be executed at all."
        },
        "severity_counts": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1SeverityCount"
          },
          "description": "Number of findings per severity, most severe first. A repeated field rather\nthan a map so severity stays a typed enum instead of a free-form key."
        }
      },
      "description": "AdvisorRun is a single execution of Advisor checks. Its totals are recorded on\ncompletion, so they stay accurate after the run's insights have been pruned."
    },
    "v1ChangeAdvisorCheckParams": {
      "type": "object",
      "properties": {
