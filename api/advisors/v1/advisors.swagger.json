    "/v1/advisors/insights": {
      "get": {
        "summary": "List Advisor Insights",
        "description": "Returns the history of Advisor check results (insights), including their outcomes.",
        "operationId": "ListInsights",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1ListInsightsResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "page_size",
            "description": "Maximum number of results per page.",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "page_index",
            "description": "Index of the requested page, starts from 0.",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "service_id",
            "description": "Filter by service ID.",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "status",
            "description": "Filter by outcome.\n\n - ADVISOR_CHECK_RESULT_STATUS_OK: The check ran and found no issue.\n - ADVISOR_CHECK_RESULT_STATUS_FAILED: The check ran and detected an issue.\n - ADVISOR_CHECK_RESULT_STATUS_ERROR: The check could not be executed.",
            "in": "query",
            "required": false,
            "type": "string",
            "enum": [
              "ADVISOR_CHECK_RESULT_STATUS_UNSPECIFIED",
              "ADVISOR_CHECK_RESULT_STATUS_OK",
              "ADVISOR_CHECK_RESULT_STATUS_FAILED",
              "ADVISOR_CHECK_RESULT_STATUS_ERROR"
            ],
            "default": "ADVISOR_CHECK_RESULT_STATUS_UNSPECIFIED"
          },
          {
            "name": "is_read",
            "description": "Filter by read state.",
            "in": "query",
            "required": false,
            "type": "boolean"
          },
          {
            "name": "from",
            "description": "Return only results recorded at or after this time.",
            "in": "query",
            "required": false,
            "type": "string",
            "format": "date-time"
          },
          {
            "name": "to",
            "description": "Return only results recorded at or before this time.",
            "in": "query",
            "required": false,
            "type": "string",
            "format": "date-time"
          },
          {
            "name": "service_name",
            "description": "Filter by service name (partial, case-insensitive match).",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "node_name",
            "description": "Filter by node name (partial, case-insensitive match).",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "category",
            "description": "Filter by advisor category.",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "check_name",
            "description": "Filter by check name.",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "severity",
            "description": "Filter by severity.",
            "in": "query",
            "required": false,
            "type": "string",
            "enum": [
              "SEVERITY_UNSPECIFIED",
              "SEVERITY_EMERGENCY",
              "SEVERITY_ALERT",
              "SEVERITY_CRITICAL",
              "SEVERITY_ERROR",
              "SEVERITY_WARNING",
              "SEVERITY_NOTICE",
              "SEVERITY_INFO",
              "SEVERITY_DEBUG"
            ],
            "default": "SEVERITY_UNSPECIFIED"
          },
          {
            "name": "run_id",
            "description": "Filter by run ID.",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "triggered_by",
            "description": "Filter by the actor that initiated the run.\n\n - ADVISOR_CHECK_TRIGGERED_BY_USER: The run was started by a user via the API or UI.\n - ADVISOR_CHECK_TRIGGERED_BY_SCHEDULER: The run was started by the built-in scheduler.",
            "in": "query",
            "required": false,
            "type": "string",
            "enum": [
              "ADVISOR_CHECK_TRIGGERED_BY_UNSPECIFIED",
              "ADVISOR_CHECK_TRIGGERED_BY_USER",
              "ADVISOR_CHECK_TRIGGERED_BY_SCHEDULER"
            ],
            "default": "ADVISOR_CHECK_TRIGGERED_BY_UNSPECIFIED"
          }
        ],
        "tags": [
          "AdvisorService"
        ]
      }
    },
