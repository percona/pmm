        "parameters": [
          {
            "name": "page_size",
            "description": "Maximum number of results per page.",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "page_index",
            "description": "Index of the requested page, starts from 0.",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "triggered_by",
            "description": "Filter by the actor that initiated the run.\n\n - ADVISOR_CHECK_TRIGGERED_BY_USER: The run was started by a user via the API or UI.\n - ADVISOR_CHECK_TRIGGERED_BY_SCHEDULER: The run was started by the built-in scheduler.",
            "in": "query",
            "required": false,
            "type": "string",
            "enum": [
              "ADVISOR_CHECK_TRIGGERED_BY_UNSPECIFIED",
