# Copy to .env, fill in the required values, then run ./install.sh. These are read by both install.sh
# and docker compose. (The HolmesGPT bootstrap .env is a DIFFERENT file — it lives in the shared config
# dir and is rendered by PMM's provisioning; you never write that one by hand.)

# ---- required ----

# ADRE-capable PMM Server image. The official percona/pmm-server:3 does NOT include ADRE — use an image
# built from the tibi-holmes fork (a Feature Build tag, or your locally-built/pushed image).
PMM_IMAGE=perconalab/pmm-server-fb:PR-4259-53ca058

# HolmesGPT image, >= 0.36.0 (native HTTPS + /api/admin/reload). Pin a digest for prod.
HOLMES_IMAGE=robustadev/holmes:0.36.0

# Your LLM. MODEL_NAME is the display/key name (letters/digits/.-_ only, NO slashes);
# LITELLM_MODEL is the LiteLLM model id; LLM_API_KEY is your provider key.
MODEL_NAME=gpt-4.1
LITELLM_MODEL=openai/gpt-4.1
LLM_API_KEY=

# ---- optional (defaults shown) ----
# Host dir shared with the containers (holds certs + PMM-rendered config). Auto-created by install.sh.
# HOLMES_CONFIG_DIR=./holmes-config
# PMM admin login install.sh uses to call the ADRE API.
# PMM_ADMIN_USER=admin
# PMM_ADMIN_PASSWORD=admin
# URLs Holmes and PMM use to reach each other on the pmm network (defaults are correct for this compose).
# HOLMES_URL=https://holmesgpt:5050
# PMM_CALLBACK_URL=https://pmm-server:8443
# Docker invocation if your user needs sudo (install.sh auto-detects; override if needed).
# DOCKER=sudo docker
