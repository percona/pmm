{
  "extends": "./.config/tsconfig.json",
  "compilerOptions": {
    "rootDir": "../..",
    "typeRoots": ["./node_modules/@types", "../../node_modules/@types"],
    "paths": {
      "@pmm/shared": ["../../../packages/shared/src"]
    }
  },
  "ts-node": {
    "compilerOptions": {
      "module": "commonjs",
      "moduleResolution": "node",
      "target": "es2018",
      "esModuleInterop": true
    },
    "transpileOnly": true
  }
}
