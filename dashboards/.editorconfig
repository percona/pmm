# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

# Unix-style newlines with a newline ending every file
[*]
end_of_line = lf
insert_final_newline = true

# Tooling under misc/
[*.py]
charset = utf-8
indent_style = space
indent_size = 4

# Dashboard definitions
[*.json]
charset = utf-8
indent_style = space
indent_size = 4
trim_trailing_whitespace = true
