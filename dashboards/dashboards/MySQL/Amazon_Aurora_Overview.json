                    "exemplar": false,
                    "expr": "count by (region, aws_account_id, aws_cluster_id) (\n(\n  max by (node_id, service_name) (mysql_up{region=~\"$region\"})\n  or\n  (max by (node_id, service_name) (last_over_time(mysql_up{region=~\"$region\"}[1h])) unless on (service_name) mysql_up{region=~\"$region\"}) * 0\n)\n* on (node_id) group_left(region, aws_account_id, aws_cluster_id)\n(\n  max by (node_id, region, aws_account_id, aws_cluster_id) (aws_rds_instance_info{aws_engine=\"aurora-mysql\",region=~\"$region\"})\n  or\n  label_replace(\n    group by (node_id, region) (last_over_time(mysql_global_status_auroradb_commits{region=~\"$region\"}[1h])) unless on (node_id) aws_rds_instance_info,\n    \"aws_cluster_id\", \"AWS cluster unknown\", \"\", \"\")\n)\n)",
