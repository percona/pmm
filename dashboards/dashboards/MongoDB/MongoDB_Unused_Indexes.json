                    "language": "plaintext",
                    "showLineNumbers": false,
                    "showMiniMap": false
                },
                "content": "<p>Find indexes with <strong>zero accesses since the last <code>mongod</code> restart</strong>. These indexes may be <strong>candidates for removal</strong>. ⚠️ <strong>Before dropping:</strong> Check usage on <strong>all replica set members</strong>. Usage is tracked per node, so an index may be unused on one member but active on another. <strong>Prerequisite:</strong> MongoDB exporter <code>indexstats</code> collector enabled.</p>",
                "mode": "html"
            },
            "pluginVersion": "11.6.4",
            "title": "Identify unused indexes",
            "type": "text"
        },
        {
            "description": "How long the selected nodes have been running since the last mongod restart. If uptime is short, index access data may not reflect real usage yet.",
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "thresholds"
                    },
                    "decimals": 1,
                    "mappings": [
                        {
                            "options": {
